# 本地开发统一环境变量样例：复制为 .env 即可，两个服务及其迁移/种子脚本都会自动加载。
# 如需为单个服务覆盖配置，可再复制 services/<service>/.env.example 为该服务目录下的 .env
# （服务级 .env 优先级高于本文件；真实环境变量优先级最高）。
#
# 数据库连接串：服务级 .env / 显式注入使用通用名 DATABASE_URL；
# 在本文件中按服务区分，使用 ACCOUNT_DATABASE_URL / DEPARTMENT_DATABASE_URL。
# 两者都缺失时脚本会立即报明确错误，而不会静默连接 localhost:5432。
# PostgreSQL（docker-compose 默认配置，宿主机映射端口为 5433）
ACCOUNT_DATABASE_URL=postgres://hospital:hospital@localhost:5433/account_service
DEPARTMENT_DATABASE_URL=postgres://hospital:hospital@localhost:5433/department_service

# 两个服务共享同一 JWT 密钥以便互信验签，生产环境必须通过密钥管理系统注入
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=8h

# 服务端口：根 .env 中按服务区分使用 ACCOUNT_PORT / DEPARTMENT_PORT；
# 服务级 .env 或显式注入时使用通用名 PORT（PORT 优先级更高）
ACCOUNT_PORT=3001
DEPARTMENT_PORT=3002
LOG_LEVEL=info
