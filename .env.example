# 本地开发统一环境变量样例（各服务也可使用自己的 .env）
# PostgreSQL（docker-compose 默认配置）
ACCOUNT_DATABASE_URL=postgres://hospital:hospital@localhost:5433/account_service
DEPARTMENT_DATABASE_URL=postgres://hospital:hospital@localhost:5433/department_service

# 两个服务共享同一 JWT 密钥以便互信验签，生产环境必须通过密钥管理系统注入
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=8h

# 服务端口
ACCOUNT_PORT=3001
DEPARTMENT_PORT=3002
LOG_LEVEL=info
