{
  "name": "@hospital/department-service",
  "version": "1.0.0",
  "description": "科室服务：科室资料与值班信息管理",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:rollback": "tsx scripts/migrate.ts --rollback",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hospital/common": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
